{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["bun", "node", "vite/client"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tool/**/*.ts", "example/**/*.ts"]
}
